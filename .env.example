# Required. Used by the planner/drafter/checker agents. The app boots without
# it, but every generation call fails at request time.
ANTHROPIC_API_KEY=sk-ant-...

# Required. Clerk handles sign-up, sign-in and sessions. Both keys are on the
# API Keys page of your Clerk dashboard. The backend verifies session tokens
# with the secret key; the frontend (Vite reads this same file) loads Clerk with
# the publishable key.
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional. The PEM public key from the same page ("JWKS Public Key"). When set,
# session tokens are verified without fetching Clerk's JWKS.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."

# Optional. Comma-separated origins the app is served from. A session token
# minted for any other origin is refused. Defaults to the dev URLs below; set
# it to your public URL in production.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:8000

# Default monthly AI budget per user, in USD. Spend is metered per API call and
# summed over the calendar month (UTC); once a user reaches this, generation is
# refused until the month rolls over. Raise it for one user with:
#   UPDATE users SET monthly_budget_micro_usd = 20000000 WHERE clerk_user_id = 'user_...';
# (micro-dollars, so 20000000 is $20).
MONTHLY_BUDGET_USD=5.00

# DATABASE_URL is optional. If unset, the app uses an on-disk SQLite file
# (./maya.db) that persists across restarts — zero setup for local dev.
#
# For PostgreSQL (recommended in production), set either of these — a bare
# postgres:// or postgresql:// URL, as Railway/Heroku/Fly hand out, is
# rewritten to the asyncpg driver automatically:
# DATABASE_URL=postgresql://user:password@localhost:5432/maya
